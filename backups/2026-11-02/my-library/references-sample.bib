@incollection{zizioulas_being_1991,
	location = {Edinburgh},
	title = {On Being a Person: Towards an Ontology of Personhood},
	abstract = {Zizioulas states the three basin meanings for a person are 'a cry for defintion (who)', 'a cry for fixed being (am), and 'a cry for particularity (I)'. God is ultimately the only one who can fulfill all these roles and give being to humanity. In Cappodocian thought, being is caused by something. Thus the Father is the arche (beginning) of the Trinity out of which Son and Spirit flow. "In God it is possible for the particular to be ontologically ultimate because relatinship is permanent and unbreakable (i)" (41) Particularity and relatinship then coincide to produce being. Ultimately, Zizioulas is concenerd with the 'why' question (ousia/ubstance) not being answered by the 'what' (particular characteristics). For this brings being into a place that can be shared by others and does not point to absolute uniqueness. Who are you? I am a man studying at St. Andrews. This does not point to the 'who' of me. My identity/ousia is just in 'me' and that I am not someone else. He writes, "The true ontongoly of hyspostasis: that someone simply is (i) and is himself (i) and not someone else, and this is sufficient to identify him as being in the true sense. Thus there is no positive quality that can be given to a hypostasis/person for this would lose absolute particularity. The true personal identity of God and person then can only be seen through relationship and not through isolated ontology. 

Zizioulas starts from Greek philsophy for personhood and his three earlier questions of "who am I?' He then moves to the Cappodocian definitions of being through arche/beginning. Finally he ends in his thesis that ultimate particularity must be in pure being of someone, not in descriptions given to him. Is this what Christ taught us? I need to see if I agree with this or not.},
	pages = {33--46},
	booktitle = {Persons, Divine and Human: King's College Essays in Theological Anthropology},
	publisher = {T\&T Clark {LTD}},
	author = {Zizioulas, John D.},
	editor = {Schwöbel, Christoph and Gunton, Colin E.},
	date = {1991},
}

